{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infosphere.local/rooms.schema.json",
  "title": "Infosphere map dataset",
  "description": "Floors, rooms and the kiosk location. Coordinates are map units of each floor (origin top-left).",
  "type": "object",
  "required": ["building", "kiosk", "floors", "rooms"],
  "additionalProperties": false,
  "properties": {
    "_comment": { "type": "string" },
    "building": { "type": "string", "minLength": 1 },
    "kiosk": {
      "type": "object",
      "required": ["floor", "room"],
      "additionalProperties": false,
      "properties": {
        "floor": { "type": "integer", "minimum": 1 },
        "room": { "$ref": "#/$defs/id" }
      }
    },
    "floors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["floor", "label", "image", "width", "height", "connector"],
        "additionalProperties": false,
        "properties": {
          "floor": { "type": "integer", "minimum": 1, "maximum": 50 },
          "label": { "type": "string", "pattern": "^Lantai \\d+$" },
          "image": { "type": "string", "pattern": "^lantai-\\d+$" },
          "alt": { "type": "string", "maxLength": 1000 },
          "width": { "type": "integer", "minimum": 100, "maximum": 5000 },
          "height": { "type": "integer", "minimum": 100, "maximum": 5000 },
          "metres_per_unit": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "walkable": { "$ref": "#/$defs/rect" },
          "inside": { "type": "array", "items": { "$ref": "#/$defs/rect" } },
          "voids": { "type": "array", "items": { "$ref": "#/$defs/rect" } },
          "connector": {
            "type": "object",
            "required": ["name", "xy"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "xy": { "$ref": "#/$defs/point" }
            }
          }
        }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "floor", "type", "aliases"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "name_en": { "type": "string", "minLength": 1, "maxLength": 80 },
          "name_zh": { "type": "string", "minLength": 1, "maxLength": 80 },
          "floor": { "type": "integer", "minimum": 1 },
          "building": { "type": "string", "enum": ["A", "B", "C", "D"] },
          "type": {
            "type": "string",
            "enum": ["classroom", "office", "library", "toilet", "studio", "hall", "lab", "facility"]
          },
          "aliases": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[^A-Z]*$" },
            "uniqueItems": true
          },
          "poly": {
            "type": "array",
            "minItems": 3,
            "maxItems": 64,
            "items": { "$ref": "#/$defs/point" }
          },
          "location": { "type": "string", "maxLength": 300 },
          "location_en": { "type": "string", "maxLength": 300 },
          "location_zh": { "type": "string", "maxLength": 300 },
          "near_escalator": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$" },
    "point": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "rect": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    }
  }
}
