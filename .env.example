# Copy to .env (or run: python scripts/set_admin_password.py, which creates it).
# .env holds secrets and is git-ignored — never commit it. On a hosting
# platform, set these as environment variables instead (real env vars win).

# 'production' = HTTPS redirect, Secure cookies, HSTS, SECRET_KEY required,
# admin reachable from other devices. Leave empty for the LAN kiosk (http://).
INFOSPHERE_ENV=

# Admin login. Only the scrypt hash is stored — create it with
# scripts/set_admin_password.py (use --print to get values for a host's dashboard).
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Long random strings (set_admin_password.py generates them).
SECRET_KEY=change-me-to-a-long-random-string
VISITOR_SALT=change-me-too

# Set to 1 when running behind a reverse proxy (nginx, Caddy, Cloudflare Tunnel,
# Render, Railway…) so the real client IP and https scheme are used.
TRUST_PROXY=0

# Where runtime data lives (SQLite DB, logs, model cache, voice cache).
# Point it at a persistent disk/volume when hosting. Default: ./instance
# INFOSPHERE_INSTANCE=/data

# Admin pages only answer requests from this computer unless the site runs in
# production (HTTPS). Set to 1 to allow other devices on plain http (not advised:
# the password would travel unencrypted over the Wi-Fi).
# ADMIN_ALLOW_REMOTE=0

# Chatbot tuning
# CHAT_TIMEOUT_SEC=10
# MATCH_THRESHOLD=0.38
# LEARN_THRESHOLD=0.60
# RETRAIN_POLL_SEC=20       # 0 = don't watch data/qa for changes

# Speech-to-text model for the server fallback: tiny | base | small
# WHISPER_MODEL=tiny

# AI voice lines (instance/voice-cache/). Set AI_VOICE_LIVE=0 to turn generation off.
# AI_VOICE_LIVE=1
# AI_VOICE_ID=id-ID-GadisNeural      # male: id-ID-ArdiNeural
# AI_VOICE_EN=en-US-AvaMultilingualNeural
# AI_VOICE_ZH=zh-CN-XiaoxiaoNeural

# Optional
# ADMIN_IDLE_MINUTES=30
# HOST=0.0.0.0
# PORT=5000
# THREADS=8
# FORCE_HTTPS=1               # defaults to on in production
# COOKIE_SECURE=1             # defaults to on in production
# INSECURE_SSL=0              # only if a campus proxy breaks HTTPS model downloads
